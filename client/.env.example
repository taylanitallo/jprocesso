# Variáveis de ambiente do FRONTEND (Vercel)
# Configure no painel do Vercel em: Settings → Environment Variables → Production
#
# ATENÇÃO: VITE_* são injetadas no bundle — nunca coloque secrets aqui!

# URL do backend Railway (sem barra final)
VITE_API_URL=https://<seu-projeto>.up.railway.app/api

# Desenvolvimento local
# VITE_API_URL=http://localhost:5001/api
