# ── SERVIDOR ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Em produção: NODE_ENV=production
# Railway define PORT automaticamente
PORT=5001

# ── BANCO (Supabase PostgreSQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_local
DB_NAME=postgres

# Produção:
# DB_HOST=aws-1-sa-east-1.pooler.supabase.com
# DB_USER=postgres.<project-ref>

# ── SEGURANÇA ──────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere_um_secret_forte_minimo_64_chars
# Dev: 7d | Produção: 15m
JWT_EXPIRE=7d

REFRESH_TOKEN_SECRET=outro_secret_diferente_do_jwt
REFRESH_TOKEN_EXPIRE=30d

# ── UPLOAD ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760

# ── SUPABASE STORAGE ──────────────────────────────────────────────────────
# NUNCA commitar a service_role key!
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jprocesso-documentos
# Bucket exclusivo para backups (NUNCA misturar com documentos)
SUPABASE_BACKUPS_BUCKET=jprocesso-backups

# ── SUPERADMIN (setup-superadmin.js) ─────────────────────────────────────
# Usado APENAS para configurar o superadmin via script — nunca para runtime.
# Execute: node server/scripts/setup-superadmin.js
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Administrador Geral

# ── CORS ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
# Produção:
# CLIENT_URL=https://<projeto>.vercel.app
# ALLOWED_ORIGINS=https://<projeto>.vercel.app
