# ========================================
# SERVIDOR
# ========================================

# Railway define PORT automaticamente — não altere em produção
PORT=5001
NODE_ENV=development
# Em produção: NODE_ENV=production

# ========================================
# BANCO DE DADOS (Supabase PostgreSQL)
# ========================================

# Desenvolvimento local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_local

# Produção (Railway/Supabase pooler)
# DB_HOST=aws-1-sa-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<seu-project-ref>
# DB_PASSWORD=<sua-senha-supabase>

# ========================================
# SEGURANÇA JWT
# ========================================

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere_um_secret_forte_minimo_64_chars_nunca_commitar
# Desenvolvimento: 7d | Produção: 15m
JWT_EXPIRE=7d

# Segredo DIFERENTE do JWT_SECRET — obrigatório em NODE_ENV=production
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
REFRESH_TOKEN_SECRET=outro_secret_forte_diferente_do_jwt_nunca_commitar
REFRESH_TOKEN_EXPIRE=30d

# ========================================
# UPLOAD DE ARQUIVOS
# ========================================

# Tamanho máximo em bytes (padrão: 10 MB)
MAX_FILE_SIZE=10485760

# ========================================
# SUPABASE STORAGE (obrigatório em produção)
# ========================================

# URL do projeto: Painel Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://<seu-project-ref>.supabase.co

# Chave service_role — NUNCA expor no frontend nem commitar!
# Painel Supabase > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Bucket PRIVADO criado em Supabase > Storage (deve existir antes do deploy)

# ========================================
# SUPERADMIN (usado só pelo script de setup)
# ========================================

# Defina estas variáveis e execute: node server/scripts/setup-superadmin.js
# Nunca commitar com valores reais.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Administrador Geral
SUPABASE_STORAGE_BUCKET=jprocesso-documentos

# ========================================
# CORS
# ========================================

# Desenvolvimento
CLIENT_URL=http://localhost:5173

# Produção: URL do frontend no Vercel (pode listar múltiplas separadas por vírgula)
# CLIENT_URL=https://<seu-projeto>.vercel.app
# ALLOWED_ORIGINS=https://<seu-projeto>.vercel.app,https://<dominio-custom>.gov.br

# ========================================
# MODO DE OPERAÇÃO
# ========================================

USE_MOCK_AUTH=false
